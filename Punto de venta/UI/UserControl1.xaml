<UserControl x:Class="Punto_de_venta.UI.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Punto_de_venta.UI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- ====== THEME / STYLES ====== -->
    <UserControl.Resources>

        <!-- Palette -->
        <Color x:Key="C_Bg">#0F1115</Color>
        <Color x:Key="C_Card">#171A21</Color>
        <Color x:Key="C_Card2">#1D2230</Color>
        <Color x:Key="C_Border">#2A3040</Color>
        <Color x:Key="C_Text">#E9ECF1</Color>
        <Color x:Key="C_Muted">#A8B0C0</Color>
        <Color x:Key="C_Accent">#7C5CFF</Color>
        <Color x:Key="C_Danger">#FF4D6D</Color>

        <SolidColorBrush x:Key="Bg" Color="{StaticResource C_Bg}"/>
        <SolidColorBrush x:Key="Card" Color="{StaticResource C_Card}"/>
        <SolidColorBrush x:Key="Card2" Color="{StaticResource C_Card2}"/>
        <SolidColorBrush x:Key="Border" Color="{StaticResource C_Border}"/>
        <SolidColorBrush x:Key="Text" Color="{StaticResource C_Text}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource C_Muted}"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource C_Accent}"/>
        <SolidColorBrush x:Key="Danger" Color="{StaticResource C_Danger}"/>

        <!-- Shadow -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="22" ShadowDepth="6" Opacity="0.35"/>

        <!-- Base -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- Card GroupBox (rounded + header badge) -->
        <Style x:Key="CardGroupBoxStyle" TargetType="{x:Type GroupBox}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Effect="{StaticResource SoftShadow}">
                                <Grid Margin="0,10,0,0">
                                    <ContentPresenter/>
                                </Grid>
                            </Border>

                            <!-- Header chip -->
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="14,0,0,0"
                                    Padding="10,4"
                                    CornerRadius="999"
                                    Background="{StaticResource Card2}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Header}"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                         />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView (rounded + dark rows) -->
        <Style TargetType="{x:Type ListView}">
            <Setter Property="Background" Value="{StaticResource Card2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListView}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#141822"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#182031"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#232B43"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox (rounded) -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{StaticResource Card2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small icon button -->
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Card2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#202844"/>
                                <Setter Property="BorderBrush" Value="#33406A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#263158"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button (Vender) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Effect="{StaticResource SoftShadow}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub labels -->
        <Style x:Key="LabelMuted" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </UserControl.Resources>

    <!-- ====== LAYOUT ====== -->
    <Grid Margin="16" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.6*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <GroupBox Grid.Column="0" Header="productos" Style="{StaticResource CardGroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>

                <ListView x:Name="lvProductos" Grid.Column="0" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButtonStyle}" Content="＋" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="－" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="✎" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="🗑" BorderBrush="{StaticResource Danger}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- RIGHT -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.0*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="factura" Style="{StaticResource CardGroupBoxStyle}">
                <Grid>
                    <ListView x:Name="lvFactura"/>
                </Grid>
            </GroupBox>

            <Border Grid.Row="1"
                    Margin="0,14,0,14"
                    Background="{StaticResource Card}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource SoftShadow}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="dinero" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="2" MinWidth="170" x:Name="txtDinero"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="cambio" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="2" MinWidth="170" x:Name="txtCambio" IsReadOnly="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="Transparent"
                    CornerRadius="18">
                <Grid>
                    <Button x:Name="btnVender"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="vender"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:UI="clr-namespace:Punto_de_venta.UI" x:Class="Punto_de_venta.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280"
        Background="#F5F6F8">

    <UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F6F8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Left navigation -->
            <Border Grid.Column="0" Background="#1E2A38">
                <DockPanel>
                    <StackPanel Margin="20" DockPanel.Dock="Top">
                        <TextBlock Text="PUNTO DE VENTA"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>
                        <Button Content="Nueva Venta" Margin="0,0,0,10" Height="44" />
                        <Button Content="Productos" Margin="0,0,0,10" Height="44"/>
                        <Button Content="Clientes" Margin="0,0,0,10" Height="44"/>
                        <Button Content="Caja" Margin="0,0,0,10" Height="44"/>
                        <Button Content="Reportes" Margin="0,0,0,10" Height="44"/>
                    </StackPanel>
                    <StackPanel Margin="20" DockPanel.Dock="Bottom">
                        <Button Content="Configuracion" Height="40"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Main content -->
            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UI:UserControl1 HorizontalAlignment="Left" Margin="385,269,0,0" Grid.RowSpan="2" VerticalAlignment="Top"/>
                <UI:UserControl1 HorizontalAlignment="Left" Margin="480,269,0,0" Grid.RowSpan="2" VerticalAlignment="Top"/>
            </Grid>
        </Grid>
    </UserControl>
</Window>
